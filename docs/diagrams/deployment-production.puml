@startuml deployment-production
!pragma layout smetana
left to right direction
skinparam linetype polyline
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam roundcorner 4
skinparam nodesep 45
skinparam ranksep 60
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #475569
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #475569
  FontColor #0F172A
}
skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #475569
  FontColor #0F172A
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #475569
  FontColor #0F172A
}
skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #64748B
  FontColor #0F172A
}

title BrewLite - Local, CI/CD và Production

together {
  package "Thiết bị người dùng" as Users {
    actor "Khách hàng\nTrình duyệt / PWA" as Customer
  }

  package "Phát triển cục bộ" as Local {
    artifact "Mã nguồn Git\napps/web / apps/api" as Source
    node "Local app\nNext.js :3000\nNestJS API :3001" as LocalApp
    node "Trình duyệt\n:3000" as LocalBrowser
    artifact "Môi trường local\napps/api/.env\nkhông commit" as LocalEnv
    node "Docker Compose up\nWeb :3000 / API :3001" as ComposeApp
    database "PostgreSQL Compose\nhost :5433 -> :5432\nvolume: brewlite-postgres-data" as ComposeDb

    Source --> LocalApp : npm run dev / start:dev
    LocalBrowser --> LocalApp : HTTP :3000 / :3001 / CORS
    LocalBrowser --> ComposeApp : HTTP :3000 / :3001 / CORS
    LocalEnv ..> LocalApp : cấu hình local
    LocalApp --> ComposeDb : localhost:5433
    ComposeApp --> ComposeDb : :5432
  }

  package "CI / Phân phối container" as CI {
    node "Kho mã nguồn GitHub" as GitHub
    node "GitHub Actions\nKiểm thử / build Web + API\ntag / digest bất biến" as Actions
    node "GHCR\nImage Web + API" as Registry
    artifact "Deploy hooks\nRENDER_API_DEPLOY_HOOK\nRENDER_WEB_DEPLOY_HOOK" as HookSecret

    GitHub --> Actions : push / merge
    Actions --> Registry : đẩy image / HTTPS :443
    Actions ..> HookSecret : đọc secret
  }

  package "Production / Render" as Production {
    node "Render edge / CDN\nTLS quản lý / HTTPS :443" as Edge
    node "Next.js Web Service\nSSR / assets\n0.0.0.0:$PORT" as Web
    node "NestJS API Web Service\n0.0.0.0:$PORT" as API
    node "Health-check Render" as HealthChecker
    database "PostgreSQL quản lý\ninternal URL :5432\nlưu trữ bền vững" as Postgres
    artifact "Cấu hình Render\nAPI: DATABASE_URL / JWT_SECRET\nWeb: NEXT_PUBLIC_API_URL (build)\nGHCR credential nếu image private" as RenderConfig
    artifact "Log service / deploy" as Logs

    Edge --> Web : HTTP đến $PORT
    Edge --> API : HTTP đến $PORT
    HealthChecker --> Web : GET health-check path
    HealthChecker --> API : GET /health
    API --> Postgres : TCP nội bộ :5432
    API ..> Postgres : startup: prisma migrate deploy + seed\n(idempotent)
    RenderConfig ..> API : runtime / xác thực pull
    RenderConfig ..> Web : build / xác thực pull
    Web ..> Logs : stdout / stderr
    API ..> Logs : stdout / stderr
  }
}

Customer --> Edge : HTTPS :443
Customer --> API : FE gọi API / HTTPS :443 / CORS
Registry --> Web : pull image theo tag / digest
Registry --> API : pull image theo tag / digest
Actions ..> Production : deploy hook / Render API\nimgURL chọn image bất biến

legend bottom
  Local: chọn chạy app local hoặc Compose; cả hai dùng cổng 3000 / 3001.
  API local có thể dùng PostgreSQL Compose qua localhost:5433; không dùng secret production local.
  Render: cùng region và internal DB URL; API public + CORS (API private cần Next.js BFF).
  Bind NestJS 0.0.0.0:$PORT; triển khai GET /health; hạn chế PostgreSQL external access khi cần.
  Gói Free: service ngủ sau 15 phút; PostgreSQL Free hết hạn sau 30 ngày, không backup.
endlegend
@enduml
