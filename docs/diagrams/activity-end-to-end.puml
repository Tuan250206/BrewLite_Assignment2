@startuml activity-end-to-end
title BrewLite — Activity Diagram End-to-End (MVP IS-01–IS-07)

skinparam defaultFontName Arial
skinparam shadowing false
skinparam dpi 120
skinparam ArrowColor #475569
skinparam ArrowThickness 1
skinparam activity {
  BackgroundColor #F8FAFC
  BorderColor #475569
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #C2410C
  StartColor #15803D
  EndColor #991B1B
  FontSize 13
}
skinparam partition {
  BackgroundColor #F1F5F9
  BorderColor #CBD5E1
  FontStyle bold
}

|Khách hàng|
start
:Mở menu;
|Frontend|
:Hiển thị sản phẩm,\ngiá, hình ảnh, tồn kho,\nsize và topping;
|Khách hàng|
:Xem chi tiết;\nchọn size, topping và số lượng;
|Frontend|
:Thêm, sửa số lượng,\nhoặc xóa sản phẩm trong giỏ;
|Khách hàng|
:Tiến hành Checkout;

|Frontend|
:Kiểm tra đăng nhập;
if () then (Đã đăng nhập)
else (Chưa đăng nhập)
  |Khách hàng|
  :Đăng ký hoặc đăng nhập;
  |Backend|
  :Xác thực thông tin;
  if () then (Thành công)
  else (Thất bại)
    |Frontend|
    :Thông báo xác thực thất bại;
    stop
  endif
endif

|Frontend|
:Gửi giỏ hàng;
|Backend|
:Kiểm tra dữ liệu;\nlấy giá từ database;\ntính lại theo size và topping;
if () then (Hợp lệ)
  :Kiểm tra tồn kho;
  if () then (Đủ hàng)
    :Tạo đơn PENDING;
  else (Không đủ hàng)
    |Frontend|
    :Thông báo hết hàng;
    |Khách hàng|
    :Điều chỉnh giỏ;\nđơn chưa được tạo;
    stop
  endif
else (Không hợp lệ)
  |Frontend|
  :Thông báo dữ liệu không hợp lệ;
  |Khách hàng|
  :Điều chỉnh giỏ;\nđơn chưa được tạo;
  stop
endif

repeat
  |Khách hàng|
  :Chọn WALLET hoặc CARD;
  |Frontend|
  :Gửi yêu cầu thanh toán\nkèm Idempotency-Key;
  |Backend|
  :Xử lý thanh toán qua Mock Gateway;
  |Frontend|
  :Hiển thị trạng thái PENDING;
  |Khách hàng|
  if () then (Rời Checkout)
    |Backend|
    :Chuyển đơn PENDING sang CANCELLED;
  else (Tiếp tục thanh toán)
    |Backend|
    :Nhận kết quả và kiểm tra\nIdempotency-Key;
    if () then (Callback lặp)
      :Trả kết quả đã ghi nhận;\nkhông xử lý lần hai;
    else (Callback mới)
      if () then (SUCCESS)
        :Chuyển đơn sang PAID;\ncập nhật tồn kho;
      else (FAILED)
        :Chuyển đơn sang PAYMENT_FAILED;
      endif
    endif
    if () then (PAYMENT_FAILED)
      |Frontend|
      :Thông báo thanh toán thất bại;
      |Khách hàng|
      if () then (Retry)
        |Backend|
        :Đưa đơn về PENDING;
        |Frontend|
        :Tạo Idempotency-Key mới;
      else (Cancel)
        |Backend|
        :Chuyển đơn sang CANCELLED;
      endif
    endif
  endif
repeat while () is (Retry thanh toán) not (PAID hoặc CANCELLED)

|Khách hàng|
:Mở lịch sử đơn hàng;
|Frontend|
:Yêu cầu đăng nhập để xem lịch sử;
|Backend|
:Xác thực và trả lịch sử,\ntrạng thái đơn của khách hàng;
|Frontend|
:Hiển thị lịch sử và trạng thái;\nPAID không có nhánh hủy;

stop
@enduml
