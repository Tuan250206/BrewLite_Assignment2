@startuml
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam wrapWidth 160
skinparam nodesep 20
skinparam ranksep 25
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #333333
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #333333
  ArrowColor #333333
}
skinparam swimlane {
  BorderColor #333333
  TitleFontColor #000000
  TitleFontSize 14
}

title BrewLite - Activity Diagram đặt hàng và thanh toán

|Khách hàng|
start
:Chọn món, tùy chọn, số lượng;
:Mở Checkout;

|Giao diện|
:Kiểm tra giỏ hàng;
if (Giỏ hàng hợp lệ?) then (Có)
else (Không)
  :Báo giỏ hàng rỗng;
  stop
endif

if (Đã đăng nhập?) then (Có)
else (Chưa)
  :Yêu cầu đăng nhập;
  |Khách hàng|
  :Nhập thông tin đăng nhập;
  |Giao diện|
  :Gửi yêu cầu đăng nhập;
  |Hệ thống|
  :Xác thực tài khoản;
  if (Đăng nhập hợp lệ?) then (Có)
  else (Không)
    |Giao diện|
    :Báo đăng nhập thất bại;
    stop
  endif
endif

|Khách hàng|
:Xác nhận giỏ hàng và thông tin đơn;
|Giao diện|
:Gửi yêu cầu tạo Order;
|Hệ thống|
:Kiểm tra dữ liệu, giá, sản phẩm và promo;
if (Dữ liệu hợp lệ?) then (Có)
else (Không)
  |Giao diện|
  :Báo dữ liệu không hợp lệ;
  stop
endif

|Hệ thống|
:Trong transaction: giữ/trừ tồn, tạo Order PENDING và OrderItems;
if (Transaction thành công?) then (Có)
else (Không)
  :Rollback toàn bộ transaction;
  |Giao diện|
  :Báo không thể tạo Order;
  stop
endif

|Giao diện|
:Hiển thị Order PENDING và tổng tiền;
|Khách hàng|
:Chọn EWALLET hoặc CARD;
|Giao diện|
:Gửi yêu cầu Payment;
|Hệ thống|
:Kiểm tra quyền, trạng thái Order, method và Idempotency-Key;
if (Yêu cầu hợp lệ?) then (Có)
  :Tạo Payment PENDING, không tạo trùng;
else (Không)
  |Giao diện|
  :Báo lỗi, hiển thị trạng thái thực tế;
  stop
endif

repeat
  |Giao diện|
  :Hiển thị hướng dẫn thanh toán mock;
  |Khách hàng|
  :Thanh toán hoặc yêu cầu đóng QR;
  if (Khách đóng QR?) then (Có)
    |Giao diện|
    :Đóng QR, hiển thị trạng thái thực tế;
    stop
  endif
  repeat
    |Hệ thống|
    :Nhận và xác thực callback, xử lý idempotency;
    if (Callback hợp lệ?) then (Có)
      if (Kết quả PAID?) then (Có)
        :Cập nhật Payment và Order PAID, không trừ tồn lần nữa;
        |Giao diện|
        :Báo thanh toán thành công;
        stop
      else (Không)
        if (Kết quả PAYMENT_FAILED?) then (Có)
          :Cập nhật Payment và Order PAYMENT_FAILED;
        else (PENDING)
          :Giữ Payment PENDING;
        endif
      endif
    else (Không)
      :Từ chối callback, giữ Payment PENDING;
    endif
  repeat while (Payment vẫn PENDING?) is (Có) not (Không)
  |Giao diện|
  :Thông báo PAYMENT_FAILED;
  |Khách hàng|
  if (Khách retry?) then (Có)
    |Giao diện|
    :Gửi retry cho Order cũ với Idempotency-Key mới;
    |Hệ thống|
    :Kiểm tra quyền và trạng thái;
    if (Backend chấp nhận retry?) then (Có)
      :Khởi tạo đúng một Payment mới cho Order cũ;
      if (Tạo Payment thành công?) then (Có)
        :Payment mới PENDING;
      else (Không)
        |Giao diện|
        :Báo lỗi, hiển thị trạng thái thực tế;
        stop
      endif
    else (Không)
      |Giao diện|
      :Báo retry bị từ chối;
      stop
    endif
  else (Không)
    if (Khách yêu cầu hủy Order?) then (Có)
      |Giao diện|
      :Gửi yêu cầu hủy;
      |Hệ thống|
      :Kiểm tra quyền và transition;
      if (Hủy hợp lệ?) then (Có)
        :Chuyển Order CANCELLED;
        |Giao diện|
        :Báo Order đã hủy;
      else (Không)
        |Giao diện|
        :Báo hủy bị từ chối;
      endif
    else (Không)
      |Hệ thống|
      :Giữ Order PAYMENT_FAILED;
      |Giao diện|
      :Hiển thị trạng thái hiện tại;
    endif
    stop
  endif
repeat while (Retry tạo Payment thành công?) is (Có) not (Không)

@enduml
