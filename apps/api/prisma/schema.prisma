generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Máy trạng thái đơn hàng theo mục 9.1
enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  PAYMENT_FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  PAYMENT_FAILED
}

enum UserRole {
  CUSTOMER
  STAFF
}

// Thực thể User (Mục 12.2 & Task 7)
model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  role           UserRole @default(CUSTOMER)
  loyaltyPoints  Int      @default(0)
  createdAt      DateTime @default(now())
  orders         Order[]
}

// Thực thể Product (Mục 12.2 & Task 2)
model Product {
  id          String      @id @default(uuid())
  name        String
  price       Float
  imageUrl    String
  stock       Int         @default(0)
  orderItems  OrderItem[]
}

// Thực thể Order (Mục 12.2 & Task 6)
model Order {
  id         String      @id @default(uuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id])
  status     OrderStatus @default(PENDING)
  total      Float
  createdAt  DateTime    @default(now())
  items      OrderItem[]
  payments   Payment[]
}

// Thực thể OrderItem (Mục 12.2 & Task 4, 5)
model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  size      String  // S, M, L
  topping   String?
  qty       Int
  lineTotal Float
}

// Thực thể Payment (Mục 12.2 & Task 8, 10 - Idempotent)
model Payment {
  id                    String        @id @default(uuid())
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id])
  idempotencyKey        String        @unique
  amount                Float
  method                String        // VÍ ĐIỆN TỬ / THẺ NGÂN HÀNG
  status                PaymentStatus @default(PENDING)
  confirmationTokenHash String?
  expiresAt             DateTime?
  providerTransactionId String?
  gatewayPaymentUrl     String?
  testAccount           String?
  testCredentialHash    String?
  createdAt             DateTime      @default(now())

  @@index([confirmationTokenHash])
  @@index([providerTransactionId])
}